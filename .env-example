NVIDIA_API_KEY=nvapi-
HF_TOKEN=hf_

# Embeddings — if you see CUDA OOM on GPUs that are mostly full (e.g. shared with vLLM), force CPU:
# ARROW_RAG_EMBEDDINGS_DEVICE=cpu
# Optional: lighter model default is all-MiniLM-L6-v2; heavier (more VRAM): sentence-transformers/all-mpnet-base-v2
# ARROW_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# ARROW_RAG_EMBEDDING_BATCH_SIZE=8